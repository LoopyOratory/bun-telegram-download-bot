# =============================================================================
# Hermes Video Bot — Environment template for Docker
# =============================================================================
# Copy to .env and fill in your values before running `docker compose up`
# =============================================================================

# Required
BOT_TOKEN=
OWNER_ID=

# Access control (comma-separated)
ALLOWED_USERS=
ALLOWED_GROUPS=

# Proxy (optional — leave empty to try direct access first)
# PROXY_URL=socks5://127.0.0.1:9050
PROXY_ENABLED=true
TOR_ENABLED=true
# TOR_PROXY_URL=socks5h://127.0.0.1:9050

# File sharing fallback for videos over Telegram's 50MB upload cap
# SHAREBOX_URL=http://filecodebox:12345
# SHAREBOX_PUBLIC_URL=https://files.example.com   # link users open; defaults to SHAREBOX_URL
# SHAREBOX_MIN_SIZE_MB=49.99                      # files >= this size go to the box (default 49.99)
# SHAREBOX_TOKEN=                                 # only needed if the box has guest upload off

# Optional overrides
LOG_LEVEL=info
# DOWNLOAD_TIMEOUT_SECONDS=3600
# ARIA2_ENABLED=false
